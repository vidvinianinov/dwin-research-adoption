{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dwin.memory-candidate/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claim", "claim_type", "scope", "confidence", "valid_until", "adoption_record_id", "rationale", "tags"],
  "properties": {
    "schema_version": { "const": "dwin.memory-candidate/v1" },
    "claim": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "claim_type": { "enum": ["setup-fact", "workflow-rule", "evaluated-lesson", "constraint"] },
    "scope": { "type": "string", "minLength": 1, "maxLength": 120 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "valid_until": { "type": "string", "minLength": 20, "maxLength": 40 },
    "adoption_record_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "tags": { "type": "array", "maxItems": 12, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$" } }
  }
}
