{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dwin.local/contracts/arxiv-search-template.schema.json",
  "title": "DWIN advanced arXiv search template",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "name", "dimension_id", "default_watch_id", "intent", "query",
    "positive_keywords", "negative_keywords", "authority", "content_trust", "instruction_authority",
    "default_sort_by", "default_sort_order", "default_max_results"
  ],
  "properties": {
    "schema_version": { "const": "dwin.arxiv-search-template/v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64 },
    "name": { "type": "string", "minLength": 2, "maxLength": 100 },
    "dimension_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64 },
    "default_watch_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64 },
    "intent": { "type": "string", "minLength": 10, "maxLength": 300 },
    "query": { "type": "string", "minLength": 2, "maxLength": 500 },
    "positive_keywords": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
    "negative_keywords": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
    "authority": { "const": "candidate-only" },
    "content_trust": { "const": "catalog-authored" },
    "instruction_authority": { "const": "none" },
    "default_sort_by": { "enum": ["relevance", "lastUpdatedDate", "submittedDate"] },
    "default_sort_order": { "enum": ["ascending", "descending"] },
    "default_max_results": { "type": "integer", "minimum": 1, "maximum": 200 }
  }
}
