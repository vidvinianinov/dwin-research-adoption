{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dwin.local/contracts/setup-source-registry.schema.json",
  "title": "DWIN registered AI-native setup roots",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "roots"],
  "properties": {
    "schema_version": { "const": "dwin.setup-sources/v1" },
    "roots": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "kind", "privacy", "registered_at"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "path": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["directory", "file"] },
          "privacy": { "const": "local-private-no-export" },
          "registered_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
