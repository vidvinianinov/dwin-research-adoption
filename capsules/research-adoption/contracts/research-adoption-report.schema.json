{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dwin.research-adoption-report/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "corpus_id", "papers", "network_requests", "endpoint_domains", "privacy", "authority", "instruction_authority", "memory_promotion"],
  "properties": {
    "schema_version": { "const": "dwin.research-adoption-report/v1" },
    "run_id": { "type": "string" },
    "corpus_id": { "const": "ai-native-pilot-v1" },
    "papers": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version_id", "version_key", "source_id", "pdf_sha256", "pdf_bytes", "status", "registered"],
        "properties": {
          "id": { "type": "string" },
          "version_id": { "type": "string" },
          "version_key": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "source_id": { "type": "string" },
          "pdf_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "pdf_bytes": { "type": "integer", "minimum": 1, "maximum": 26214400 },
          "status": { "enum": ["downloaded", "cache-hit"] },
          "registered": { "const": true }
        }
      }
    },
    "network_requests": { "type": "integer", "minimum": 0, "maximum": 5 },
    "endpoint_domains": { "type": "array", "items": { "const": "arxiv.org" }, "uniqueItems": true },
    "privacy": { "const": "local-private-no-export" },
    "authority": { "const": "candidate-only" },
    "instruction_authority": { "const": "none" },
    "memory_promotion": { "const": "forbidden" }
  }
}
