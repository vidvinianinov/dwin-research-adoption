{
  "schema_version": "dwin.document-policy/v1",
  "parser": "docling",
  "parser_version": "2.126.0",
  "supported_extensions": [".pdf"],
  "max_sources": 16,
  "max_documents_per_run": 1,
  "max_file_bytes": 26214400,
  "max_pages": 64,
  "max_blocks": 20000,
  "max_block_characters": 20000,
  "max_search_results": 20,
  "max_preview_characters": 2000,
  "ocr_engine": "ocrmac",
  "ocr_languages": ["en-US", "ru-RU"],
  "table_structure": true,
  "formula_enrichment": false,
  "heading_hierarchy": true,
  "remote_services": false,
  "external_plugins": false,
  "privacy": "local-private-no-export",
  "instruction_authority": "none",
  "authority": "parsed-evidence-candidate-only"
}
