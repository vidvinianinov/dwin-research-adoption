{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dwin.document-sources/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": { "const": "dwin.document-sources/v1" },
    "sources": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "privacy", "registered_at"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "path": { "type": "string", "minLength": 1 },
          "privacy": { "const": "local-private-no-export" },
          "registered_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
