{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dwin.local/contracts/capsule.schema.json",
  "title": "DWIN Factory capsule",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "description", "capabilities", "jobs", "evaluators"],
  "properties": {
    "schema_version": { "const": "dwin.capsule/v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string", "minLength": 10, "maxLength": 240 },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "write_scope"],
      "properties": {
        "network": { "type": "boolean" },
        "allowed_domains": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "read_scopes": {
          "type": "array",
          "items": { "enum": ["codex-sessions", "claude-sessions", "kiro-sessions", "registered-documents"] },
          "uniqueItems": true
        },
        "write_scope": { "enum": ["run-output-only", "factory-data"] }
      }
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "script", "timeout_seconds", "schedule"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "script": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+\\.mjs$" },
          "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 300 },
          "schedule": { "enum": ["manual", "daily", "weekly"] }
        }
      }
    },
    "evaluators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "script", "timeout_seconds"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "script": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+\\.mjs$" },
          "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 300 }
        }
      }
    }
  }
}
